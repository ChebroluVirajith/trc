# =================================================================
# CASHFREE PAYMENT GATEWAY CONFIGURATION
# Add these variables to your Vercel Project Settings:
# Settings -> Environment Variables -> Add New
# =================================================================

# Mode: 'SANDBOX' for testing or 'PRODUCTION' for live payments
CASHFREE_ENV=SANDBOX

# Cashfree API Credentials (obtained from Cashfree Merchant Dashboard)
# Replace these with your own values from the Cashfree dashboard
CASHFREE_APP_ID=YOUR_CASHFREE_APP_ID
CASHFREE_SECRET_KEY=YOUR_CASHFREE_SECRET_KEY

# API Version (Recommended: 2023-08-01)
CASHFREE_API_VERSION=2023-08-01

# Client-Side Mode for React frontend: 'sandbox' | 'production'
VITE_CASHFREE_MODE=sandbox
